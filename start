#!/bin/sh
set -eu

case "${1:-}" in
  server)
    exec "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/scripts/start-server.sh" "${2:-}"
    ;;
  web)
    exec "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)/scripts/start-dashboard.sh"
    ;;
  *)
    echo "Uso: ./start server [caminho-do-modelo] | ./start web" >&2
    exit 64
    ;;
esac
